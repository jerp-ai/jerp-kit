{
  "name": "jerp-kit",
  "version": "0.1.0",
  "status": "draft",
  "repository": "https://github.com/jerp-ai/jerp-kit",
  "connect": {
    "mcp": "https://getjerp.com/mcp",
    "rest": "https://getjerp.com/api/v1/",
    "openapi": "https://getjerp.com/api/v1/openapi.json"
  },
  "tools": [
    "guard",
    "verdict",
    "speaker",
    "support"
